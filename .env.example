PORT=4000
HOST=127.0.0.1
# Local development defaults to SQLite.
DATABASE_DRIVER=sqlite
DATABASE_PATH=./data/taskforge.db
# Production MySQL example (URL-encode special characters in credentials):
# DATABASE_DRIVER=mysql
# DATABASE_URL=mysql://taskforge:password@127.0.0.1:3306/taskforge
JWT_SECRET=replace-with-a-long-random-secret
# Used to encrypt agent API tokens so admins can reveal them later. Defaults to JWT_SECRET when unset.
# TOKEN_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
# Comma-separated when the API is accessed directly from multiple web origins.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set TRUST_PROXY to true only behind a trusted proxy, or to a comma-separated list of trusted proxy IPs.
# TRUST_PROXY=10.0.0.1
# Sensitive endpoint throttling (defaults are suitable for local development; tune behind a shared edge limiter).
# LOGIN_RATE_LIMIT_IP=20
# LOGIN_RATE_LIMIT_ACCOUNT=8
# SENSITIVE_RATE_LIMIT=30
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_BACKOFF_MS=900000
# Optional in local development because Vite proxies /api to the backend.
# VITE_API_URL=https://api.example.com/api
