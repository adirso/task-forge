PORT=4000
HOST=127.0.0.1
# Local development defaults to SQLite.
DATABASE_DRIVER=sqlite
DATABASE_PATH=./data/taskforge.db
# Production MySQL example (URL-encode special characters in credentials):
# DATABASE_DRIVER=mysql
# DATABASE_URL=mysql://taskforge:password@127.0.0.1:3306/taskforge
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated when the API is accessed directly from multiple web origins.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional in local development because Vite proxies /api to the backend.
# VITE_API_URL=https://api.example.com/api
