# Smithy is a separate process from the TaskForge API.
TASKFORGE_API_URL=http://127.0.0.1:4000
SMITHY_HOST=127.0.0.1
SMITHY_PORT=4500
SMITHY_DB_PATH=./data/smithy.sqlite
# Optional safe startup checks. The /health/providers endpoint is always available;
# setting this true also runs diagnostics when Smithy starts.
SMITHY_PREFLIGHT=false

# Replace every placeholder with values from TaskForge Settings > Agents.
# Keep this file private; do not commit a real .env.smithy file.
SMITHY_PROVIDERS='{"claude":{"cmd":"claude -p --permission-mode auto {prompt}","webhookSecret":"whsec_replace_me","apiToken":"tf_replace_me"},"codex":{"cmd":"codex exec --approve-for-me {prompt}","webhookSecret":"whsec_replace_me","apiToken":"tf_replace_me"},"cursor":{"cmd":"cursor-agent -p --force --trust {prompt}","webhookSecret":"whsec_replace_me","apiToken":"tf_replace_me"}}'
# A provider may optionally set "healthCmd" to an operator-owned login/status
# command. Without it Smithy checks only the configured executable with --version.

# Or generate/edit this value safely with:
# npm run configure -w @taskforge/smithy -- --file .env
