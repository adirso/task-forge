# Smithy is a separate process from the TaskForge API.
TASKFORGE_API_URL=http://127.0.0.1:4000
SMITHY_HOST=127.0.0.1
SMITHY_PORT=4500
SMITHY_DB_PATH=./data/smithy.sqlite

# Replace every placeholder with values from TaskForge Settings > Agents.
# Keep this file private; do not commit a real .env.smithy file.
SMITHY_PROVIDERS='{"claude":{"cmd":"claude -p {prompt}","webhookSecret":"whsec_replace_me","apiToken":"tf_replace_me"},"codex":{"cmd":"codex exec {prompt}","webhookSecret":"whsec_replace_me","apiToken":"tf_replace_me"}}'

# Or generate/edit this value safely with:
# npm run configure -w @taskforge/smithy -- --file .env
