{
  "name": "taskforge",
  "version": "0.1.6",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w @taskforge/contracts",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @taskforge/api\" \"npm run dev -w @taskforge/web\"",
    "build": "npm run build -w @taskforge/contracts && npm run build -w @taskforge/api && npm run build -w @taskforge/web",
    "pretypecheck": "npm run build -w @taskforge/contracts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:seed": "npm run db:seed -w @taskforge/api",
    "admin:bootstrap": "npm run admin:bootstrap -w @taskforge/api",
    "dev:agents": "npm run dev -w @taskforge/smithy",
    "dev:delivery-monitor": "npm run dev -w @taskforge/delivery-monitor",
    "delivery-monitor:sync": "npm run sync -w @taskforge/delivery-monitor",
    "test:version": "node --test scripts/check-version.test.mjs",
    "test:release-tag": "node --test scripts/release-tag.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
